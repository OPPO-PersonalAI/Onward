node_modules/
out/
release/
dist/
.pnpm-store/
*.log
current_tasks_*.md
current_tasks-*.md
current-state-*.md
# Python bytecode caches — created at any depth by `python3 <script>.py`.
# No leading slash so the pattern matches `__pycache__/` and `*.pyc` in the
# repo root as well as any subdirectory (e.g. test/autotest/__pycache__/).
__pycache__/
*.pyc
test/autotest/results/
test/autotest/fixtures/*/user-data/
test/autotest/fixtures/*/workdir/
# Per-run scratch that fixture builders (create-*-fixture.mjs) wipe-and-rebuild
# under a committed fixture dir. Like user-data/ and workdir/ above, this must
# never pollute the working tree — the committed source lives one level up.
test/autotest/fixtures/*/runtime/
# Legacy local test scratch directories. Reusable fixtures belong under
# test/autotest/fixtures/ and run outputs belong under test/autotest/results/,
# test/full-regression-results/, or traces/.
test/fixtures/
test/results/
# Runtime output: Perfetto / Chrome trace JSON, autotest logs, profile
# dumps. Never committed; the directory itself is kept via traces/.gitkeep.
traces/*
!traces/.gitkeep
logs/
.DS_Store
# Local scheduled-task lock and other .claude/*.lock files produced by skill runtimes.
.claude/*.lock
# Per-developer Claude Code permission overrides. These vary by machine and
# trust model and must not be checked into the repo.
.claude/settings.local.*
# Full regression run outputs from test/autotest/run-full-regression.py.
# Kept locally for inspection but never committed.
test/full-regression-results/
# Runtime artifact: zsh writes its history into the shell-integration ZDOTDIR
# (pty-manager points ZDOTDIR at this committed config dir). The .zsh_* configs
# are committed; the generated history file is per-run scratch, never committed.
resources/shell-integration/zsh-zdotdir/.zsh_history
